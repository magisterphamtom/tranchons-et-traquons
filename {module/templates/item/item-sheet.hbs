<div class="tnt-sheet tnt-item-sheet">

  <!-- ══ EN-TÊTE ══════════════════════════════════════ -->
  <header class="item-sheet-header">
    <div class="item-portrait-zone">
      <img class="item-img" src="{{item.img}}" data-edit="img" title="Changer l'icône" />
    </div>
    <div class="item-header-info">
      <input class="item-name-input" type="text" name="name" value="{{item.name}}" />
      <div class="item-type-badge">
        {{#if (eq item.type "don")}}✨ Don
        {{else if (eq item.type "avantage")}}⭐ Avantage
        {{else if (eq item.type "faiblesse")}}💀 Faiblesse
        {{else if (eq item.type "arme")}}⚔ Arme
        {{else if (eq item.type "equipement")}}🎒 Équipement
        {{else}}{{item.type}}{{/if}}
      </div>
    </div>
  </header>

  <!-- ══ CORPS ════════════════════════════════════════ -->
  <div class="item-sheet-body">

    {{!-- DON --}}
    {{#if (eq item.type "don")}}
    <div class="item-field-group">
      <label class="item-field-label"><i class="fas fa-hat-wizard"></i> Classe d'origine</label>
      <select name="system.classe_origine" class="item-select">
        {{selectOptions classeChoices selected=system.classe_origine}}
      </select>
    </div>
    <div class="item-field-group">
      <label class="item-field-label"><i class="fas fa-bolt"></i> Effet</label>
      <input type="text" name="system.effet" value="{{system.effet}}"
             class="item-input" placeholder="Résumé de l'effet..." />
    </div>
    {{/if}}

    {{!-- AVANTAGE --}}
    {{#if (eq item.type "avantage")}}
    <div class="item-field-group">
      <label class="item-field-label"><i class="fas fa-star"></i> Score (1–5)</label>
      <div class="item-score-selector">
        {{#each (array 1 2 3 4 5) as |n|}}
        <label class="score-option {{#if (eq n ../system.score)}}active{{/if}}">
          <input type="radio" name="system.score" value="{{n}}"
                 {{#if (eq n ../system.score)}}checked{{/if}} />
          {{n}}
        </label>
        {{/each}}
      </div>
    </div>
    {{/if}}

    {{!-- ARME --}}
    {{#if (eq item.type "arme")}}
    <div class="item-fields-row">
      <div class="item-field-group">
        <label class="item-field-label"><i class="fas fa-khanda"></i> Type</label>
        <select name="system.type" class="item-select">
          <option value="melee"    {{#if (eq system.type "melee")}}selected{{/if}}>Mêlée</option>
          <option value="distance" {{#if (eq system.type "distance")}}selected{{/if}}>Distance</option>
        </select>
      </div>
      <div class="item-field-group">
        <label class="item-field-label"><i class="fas fa-plus-circle"></i> Bonus au jet</label>
        <input type="number" name="system.bonus" value="{{system.bonus}}"
               class="item-input-small" min="-5" max="10" />
      </div>
      <div class="item-field-group">
        <label class="item-field-label"><i class="fas fa-fire"></i> Bonus dégâts</label>
        <input type="number" name="system.degats_bonus" value="{{system.degats_bonus}}"
               class="item-input-small" min="-5" max="10" />
      </div>
    </div>
    {{/if}}

    {{!-- ÉQUIPEMENT --}}
    {{#if (eq item.type "equipement")}}
    <div class="item-field-group">
      <label class="item-field-label"><i class="fas fa-tag"></i> Type</label>
      <select name="system.type" class="item-select">
        <option value="besace"   {{#if (eq system.type "besace")}}selected{{/if}}>Besace (+2)</option>
        <option value="armure"   {{#if (eq system.type "armure")}}selected{{/if}}>Armure</option>
        <option value="divers"   {{#if (eq system.type "divers")}}selected{{/if}}>Divers</option>
      </select>
    </div>
    {{/if}}

    <!-- Description (tous les types) -->
    <div class="item-field-group">
      <label class="item-field-label"><i class="fas fa-scroll"></i> Description</label>
      <textarea name="system.description" class="item-textarea"
                rows="4" placeholder="Description, règles spéciales...">{{system.description}}</textarea>
    </div>

  </div>
</div>
