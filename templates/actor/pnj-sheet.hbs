<div class="tnt-sheet pnj">
  <header class="sheet-header">
    <img class="profile-img" src="{{actor.img}}" data-edit="img" title="{{actor.name}}" />
    <div class="header-fields">
      <input class="actor-name" type="text" name="name" value="{{actor.name}}" />
      <div class="bio-row">
        <div class="bio-field">
          <label>Peuple</label>
          <select data-field="system.biographie.peuple">
            {{selectOptions peupleChoices selected=bio.peuple}}
          </select>
        </div>
        <div class="bio-field">
          <label>Type</label>
          <input type="text" data-field="system.biographie.type_monstre" value="{{bio.type_monstre}}" placeholder="Bandit, Troll..." />
        </div>
      </div>
      <div class="sante-row">
        <div class="pv-block">
          <label>Points de Vie</label>
          <div class="pv-boxes">
            {{#each pvRange as |n|}}
              <span class="pv-box {{#if (lte n ../pvValue)}}active{{/if}}"
                    data-action="pvClick" data-val="{{n}}"></span>
            {{/each}}
          </div>
          <span class="pv-text">{{pvValue}} / {{pvMax}}</span>
        </div>
        <div class="stat-box">
          <label>Armure</label>
          <input type="number" data-field="system.combat_stats.armure" value="{{armure}}" min="0" max="10" style="width:40px;text-align:center;background:transparent;border:none;color:var(--tnt-or);font-size:1.3em;font-weight:bold;" />
        </div>
        <div class="stat-box"><label>Dégâts</label><span>{{degats}}</span></div>
        <div class="stat-box">
          <label>Difficulté</label>
          <select data-field="system.combat_stats.difficulte" style="background:#1a1008;color:#e8c97a;border:1px solid var(--tnt-or);">
            <option value="0"  {{#if (eq system.combat_stats.difficulte 0) }}selected{{/if}}>0 Petit bras</option>
            <option value="-2" {{#if (eq system.combat_stats.difficulte -2)}}selected{{/if}}>−2 Gros bras</option>
            <option value="-4" {{#if (eq system.combat_stats.difficulte -4)}}selected{{/if}}>−4 Brutasse</option>
            <option value="-6" {{#if (eq system.combat_stats.difficulte -6)}}selected{{/if}}>−6 Grand chef</option>
          </select>
        </div>
      </div>
    </div>
  </header>

  <div class="traits-grid pnj-traits" style="padding:10px;">
    {{#each traitsListe as |trait|}}
    <div class="trait-row" data-trait="{{trait.key}}">
      <div class="trait-label">{{trait.label}}</div>
      <div class="trait-stars">
        {{#each (array 1 2 3 4 5) as |n|}}
          <span class="etoile {{#if (lte n ../trait.valeur)}}active{{/if}}"
                data-val="{{n}}">★</span>
        {{/each}}
      </div>
      <button type="button" class="btn-roll" data-action="traitRoll" data-trait="{{trait.key}}">
        <i class="fas fa-dice"></i>
      </button>
    </div>
    {{/each}}
  </div>

  <div class="bio-section" style="padding:10px;">
    <label>Description / Notes</label>
    <textarea data-field="system.biographie.description" rows="4">{{bio.description}}</textarea>
  </div>
</div>
