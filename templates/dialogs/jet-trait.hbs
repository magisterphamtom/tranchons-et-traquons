<div class="tnt-jet-dialog">

  <!-- En-tête trait -->
  <div class="jet-header">
    <div class="jet-trait-nom"><i class="{{jetTraitIcon}}"></i> {{jetTraitLabel}}</div>
    <div class="jet-trait-val">Valeur : <strong>{{jetTraitValeur}}</strong></div>
  </div>

  <!-- Avantages disponibles -->
  {{#if avantages.length}}
  <div class="jet-section">
    <label class="jet-section-titre"><i class="fas fa-star"></i> Utiliser un avantage</label>
    <select id="jet-avantage">
      <option value="0">— Aucun —</option>
      {{#each avantages as |av|}}
      {{#unless av.system.utilise}}
      <option value="{{av.system.score}}" data-id="{{av.id}}">
        {{av.name}} (+{{av.system.score}})
      </option>
      {{/unless}}
      {{/each}}
    </select>
  </div>
  {{/if}}

  <!-- Faiblesses -->
  {{#if faiblesses.length}}
  <div class="jet-section">
    <label class="jet-section-titre"><i class="fas fa-skull-crossbones"></i> Faiblesse active</label>
    <select id="jet-faiblesse">
      <option value="0">— Aucune —</option>
      {{#each faiblesses as |f|}}
      <option value="-4" data-id="{{f.id}}">{{f.name}} (−4)</option>
      {{/each}}
    </select>
    <small>Le MJ active une faiblesse contre vous</small>
  </div>
  {{/if}}

  <!-- Besace -->
  {{#if equipements.length}}
  <div class="jet-section">
    <label class="jet-section-titre"><i class="fas fa-backpack"></i> Utiliser la besace</label>
    <select id="jet-besace">
      <option value="0">— Aucun —</option>
      {{#each equipements as |eq|}}
      {{#unless eq.system.utilise_partie}}
      <option value="2" data-id="{{eq.id}}">{{eq.name}} (+2)</option>
      {{/unless}}
      {{/each}}
    </select>
  </div>
  {{/if}}

  <!-- Modificateur libre -->
  <div class="jet-section">
    <label class="jet-section-titre"><i class="fas fa-sliders-h"></i> Difficulté / bonus libre</label>
    <div class="jet-modif-row">
      <button type="button" class="jet-diff-btn" data-val="-6">Improbable<br>−6</button>
      <button type="button" class="jet-diff-btn" data-val="-4">Très diff.<br>−4</button>
      <button type="button" class="jet-diff-btn" data-val="-2">Difficile<br>−2</button>
      <button type="button" class="jet-diff-btn active" data-val="0">Moyen<br>0</button>
      <button type="button" class="jet-diff-btn" data-val="2">Facile<br>+2</button>
    </div>
    <div class="jet-modif-custom">
      <label>Autre :</label>
      <input type="number" id="jet-modif-libre" value="0" min="-10" max="10" />
    </div>
  </div>

  <!-- Résumé en temps réel -->
  <div class="jet-resume">
    <span class="jet-formule" id="jet-formule">2D6 + {{jetTraitValeur}} = ?</span>
    <span class="jet-seuil">Seuil : <strong>8</strong></span>
  </div>

</div>
